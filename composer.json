{
    "name": "electrik/electrik",
    "description": "Starter kit for Laravel based SaaS projects",
    "version": "4.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "neerajsohal",
            "email": "hello@neerajkumar.name"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "electrik/slate": "^1.0",
        "illuminate/support": "^12.0",
        "laravel/cashier": "^15.0",
        "laravel/sanctum": "^4.0",
        "livewire/livewire": "^3.0",
        "rappasoft/laravel-livewire-tables": "^3.0",
        "spatie/laravel-permission": "^6.4",
        "usernotnull/tall-toasts": "^2.1",
        "wire-elements/modal": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Electrik\\": "src/"
        },
        "files": [
            "src/Helpers/timezones.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Electrik\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Electrik\\ElectrikServiceProvider"
            ],
            "aliases": {
                "Electrik": "Electrik\\Facades\\Electrik"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
