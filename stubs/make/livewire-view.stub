<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight text-foreground">{{ title }}</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            Generated by <code class="text-xs">electrik:make:livewire</code>. Replace this copy with your product UI.
        </p>
    </div>

    <x-slate::card>
        <x-slate::card-header>
            <x-slate::card-title>{{ title }}</x-slate::card-title>
            <x-slate::card-description>Scaffolded Livewire view using Slate.</x-slate::card-description>
        </x-slate::card-header>
        <x-slate::card-content>
            <p class="text-sm text-muted-foreground">
                Wire your query, forms, and actions here.
            </p>
        </x-slate::card-content>
    </x-slate::card>
</div>
